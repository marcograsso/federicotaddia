{% extends "layouts/base.twig" %}

{% block content %}
  {% if post.title == "Bio"%} 
    {% include 'components/page-bio.twig' %}
  {% elseif post.title == "Contatti"%} 
    {% include 'components/page-contatti.twig' %}
  {% elseif post.title == "Credits"%} 
    {% include 'components/page-credits.twig' %}
  {% else %}
    {% include 'components/page-archive.twig' %}
  {% endif %}
  <div class="hidden">
    {{ do_shortcode('[facetwp template="parlo_posts"]') }}
  </div>
{% endblock content %}
