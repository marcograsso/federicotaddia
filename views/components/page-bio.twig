<div class="content-wrapper overflow-hidden">
  <div id="page-header" class="w-min bg-white">
    {% include "components/header.twig" with {
      color: "dark",
      animation: "transition-header-up",
      homepage: "homepage4"
    } %}
  </div>

  <div
    x-data="{
      currentBg: '{{ bios[0].foto.url }}',
      currentCredit: '{{
    bios[0].photo_credit
    }}',
      defaultCredit: '{{ bios[0].photo_credit }}',
      defaultBg: '{{
    bios[0].foto.url
    }}',
      setBg(url, credit) {
        this.currentBg = url;
        this.currentCredit = credit;
      },
      resetBg() {
        this.currentBg = this.defaultBg;
        this.currentCredit = this.defaultCredit;
      }
    }"
    class="!pointer-events-none flex w-full flex-col flex-nowrap md:mx-8 md:h-screen md:flex-row"
  >
    <!-- Image + Credit Panel -->
    <div
      class="transition-bio-top-later pointer-events-none relative hidden md:flex min-h-[38rem] w-full flex-col pt-[13rem] pb-8 md:h-full md:w-1/3 md:pt-[15rem]"
    >
      <div
        class="relative flex flex-1 flex-col items-center justify-center overflow-hidden"
      >
        <img
          :src="currentBg"
          alt="Background"
          class="pointer-events-none mx-4 max-h-[97%] w-full object-contain md:mx-0"
        />
        <span
          x-show="currentCredit"
          x-text="'credits: ' + currentCredit"
          class="pointer-events-auto mt-2 mb-2 block text-left text-xs text-gray-300 hover:text-black"
        >

        </span>
      </div>
    </div>

    <!-- Bio List -->
    <div
      class="transition-bio-top h-full w-full overflow-scroll md:w-2/3 md:pt-[15rem] md:mt-0 mt-60"
    >
      <!-- Bio titolo -->
      <div
        class="mwg_effect027 mwg_effect027-bio mwg_effect027-align-left ml-4 md:ml-[1.4rem]"
      >
        <ul>
          <li>
            <span class="letter font-funnel mr-2 text-[9rem]">
              <span>B</span><span>B</span>
            </span>
            <span class="letter font-funnel mr-2 text-[9rem]">
              <span>i</span><span>i</span>
            </span>
            <span class="letter font-funnel mr-2 text-[9rem]">
              <span>o</span><span>o</span>
            </span>
          </li>
        </ul>
      </div>

      <div class="mx-6 md:ml-[2rem]" x-data="{ hovered: null }">
        {% for bio in bios %}
          <div
            class="group {{
            loop.first
              ? "hover:border-t-transparent border-t-[0]"
              : ""
            }} !pointer-events-auto flex w-full cursor-pointer flex-col items-start gap-2 border-t-[1px] border-b-[1px] border-neutral-300 border-t-transparent py-[2rem] transition-all duration-300 hover:border-t-[#2545D7] hover:border-b-[#2545D7] hover:py-[3rem] md:w-4/5 md:flex-row md:flex-nowrap md:items-center md:gap-6"
            @mouseenter="
              hovered = {{
            loop.index
            }};
              {% if bio.foto %}setBg('{{ bio.foto.url }}', '{{
            bio.photo_credit
            }}'){% endif %}
            "
            @mouseleave="
              hovered = null;
              
            "
            :class="{
              'opacity-100': hovered === {{
            loop.index
            }},
              'opacity-50': hovered !== null && hovered !== {{
            loop.index
            }}
            }"
          >
            <h2
              class="font-funnel text-left text-[1.6rem] font-bold transition-all duration-400 group-hover:scale-[1.05] group-hover:text-[#2545D7] selection:bg-[#2545D7] selection:text-white"
            >
              {{ bio.title }}
            </h2>
            <span
              class="rich-text font-montserrat block transition-all duration-400 group-hover:translate-x-[0.8rem] group-hover:scale-[1.05] group-hover:text-[#2545D7] selection:bg-[#2545D7] selection:text-white"
            >
              {{ bio.descrizione }}
            </span>
            {% if bio.foto %}<img class="w-full pt-5 md:hidden" src="{{bio.foto.url}}">{% endif %}
            </span>
          </div>
        {% endfor %}
        <div class="pt-20">
          {% include "partials/internal-footer.twig" %}
        </div>
      </div>
    </div>
  </div>
</div>

{% include "components/prossimamente.twig" %}
